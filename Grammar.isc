name VacParser;

STRING:
    '"' @ ( '\\' . | [^"\\] )* '"'

    {@}
;
ID:
    @ ([A-Za-z_] [A-Za-z0-9_]*)

    {@}
;
alias:
    'alias' @ ID '{'
        @ #value+
    '}'

    @{name, value}

    #value:
        @ STRING | ID
        @ candidate.declarator.value.weight?

        @{value, weight}
    ;
;
candidate:
    'candidate' @ ID ':' @ #declarator+ ';'

    @{name, declarator}

    #declarator:
        @ ID '{' @ #value+ '}'

        @{type, value}

        #value:
            @('require' | 'never' )? @ ID | STRING | #any @ #weight?

            @{modifier, value, weight}

            #any:
                'any' '(' (@ ID | STRING ',')+ @ ID | STRING ')'
                @{list, last}
            ;
            #weight:
                'weight' @[0-9.]+

                {@}
            ;
       ;
    ;
;