NUMBER:
    @ [0-9]+
    @{main}
;

STRING:
    '"' \s0 @ [^"]* \s0 '"'
    {@}
;

rv:
    @ NUMBER | STRING
    {@}
;

array:
    '[' @ json (',' @ json)* ']'
    @{first, sequence}
;

map:
    '{' @ STRING ':' @ json (',' @ STRING ':' @ json)* '}'
    @{key, value, keys, values}
;

json:
    @ map | array | rv
    {@}
;

main:
    @ json
    {@}
;