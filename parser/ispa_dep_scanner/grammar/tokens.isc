module scanner_tokens;
PY_RAW: @ 'p{' [^}]* '}' {@};

// Opaque Python action blocks are lexed using IspaLexer's shared boundary code.
STRING:
    @ (['] ([^'\\\0] | ('\\' [^\0]))* [']) | (["] ([^"\\\0] | ('\\' [^\0]))* ["])
    {@}
;
CGROUP:
    @ '[' ([^\\\]\0] | ('\\' [^\0]))* ']'
    {@}
;
COMMENT:
    @ ('//' [^\r\n\0]*) | ('/*' ([^*\0] | ('*'+ [^*/\0]))* '*'+ '/')
    {@}
;
OTHER: @ [^\0a-zA-Z0-9_ \t\r\n(){};'"#\[\]] {@};
