name:
    @ ID ('->' @ ID)* @ template_params?

    @{primary, nested, temp_params}
    #template_params:
        '<' @ param? '>'
        {@}
    ;
    #param:
        @ ID (',' @ ID)*
        @{first_p, following_p}
    ;
;
module_path:
    @ ID ('->' @ ID)*
    @{primary, nested}
;

mod_import:
    'import' @ import_value ';'
    {@}

    #import_value:
        @ module_import | from_import
        {@}

        #module_import:
            @ module_path ('as' @ ID)?
            @{source, alias}
        ;

        #from_import:
            @ selection 'from' @ module_path
            @{sel, source}

            #selection:
                @ ALL | items
                {@}

                #ALL:
                    '*'
                    {@}
                ;

                #items:
                    '{' @ module_path (',' @ module_path)* '}'
                    @{first, sequence}
                ;
            ;
        ;
    ;
;

mod_detach:
    'detach' @ module_path ';'
    {@}
;
ID:
    @ ([a-zA-Z_] [a-zA-Z0-9_]*)
    {@}
;
main: @ mod_import | mod_detach
    {@}
;