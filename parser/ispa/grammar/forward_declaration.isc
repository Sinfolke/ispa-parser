module forward_declaration -> fwd;

import {ID} from common;

fwd:
    @ cls | fun
    
    {@}
;
cls:
    'class' @ ID ':' @ class_method | class_property
    @{name, decls}
    #class_method:
        'method' @ fun_forward
        {@}
    ;
    #class_property:
        'property' @ ID ':' @ ID
        @{name, type}
    ;
;
fun:
    'fn' @ fun_forward
    {@}
;

fun_forward:
    @ ID '(' (@ ID ':' @ ID ',')* ')'
    @{name, param_names, param_types}
;