module common;
import extern python ispa_python as python;

ID:
    @ ([a-zA-Z_] [a-zA-Z0-9_]*)
    {@}
;
NUMBER:
    @ [0-9]+ ('.' @ [0-9]+)?

    @{full, floating}
;
name:
    @ ID ('.' @ ID)* @ template_params? @ params?

    @{primary, nested, temp_params, param}
;

expr:
    @ python.expr
    {@}
;

explicit_expr:
    '(' @ expr ')'
    {@}
;
stmt:
    @ python.stmt
    {@}
;
params:
    '>' '(' @ param? ')'
    {@}
;
template_params:
    '<' @ param? '>'
    {@}
;
param:
    @ ID (',' @ ID)*
    @{first_p, following_p}
;
