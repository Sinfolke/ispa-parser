module rule.advanced -> advanced_rule;

import {name, ID} from common;
import {stmt} from ispa_python;
import forward_declaration;
import rule.regular;
advanced_rule:
    '{' @ dep_decl* @ (regular_match | stmt)* '}'

    @{dep, body}
    #dep_decl:
        'depends' @ forward_declaration
        {@}
    ;
    #regular_match:
        'match' @ rule.regular.value+ @ unpack? ';'
        @{patterns, assign_names}

        #unpack:
            '->' @ ID+

            {@}
        ;
    ;
    #fail_call:
        'fail' @ name

        {@}
    ;
;
