module rule.regular -> regular_rule;
import grammar;
import {name, ID, NUMBER} from common;
import {expr} from ispa_python;

regular_rule:
    ':' @ value+ @ ast? @ f_binding? @ nested_rule* % ';'
    @{v, ast_pointer, fail_pointer, nested}
    %{missing_colon}
;
ast:
    @ abbr | full | single_value
    {@}

    #full:
        '&=' '{' @ part+ '}'

        {@}

        #part:
            @ ID %ast_field_separator ':' @ expr
            @{key, e}
        ;
    ;
    #abbr:
        '@' '{' @ ID (',' @ ID )* '}'
        @{f, seq}
    ;
    #single_value:
        '{' @ expr | '@' '}'
        {@}
    ;
;
f_binding:
    '%' '{' @ ID (',' @ ID )* '}'
    @{f, seq}
;
value:
    @ one_capture | mul_capture

    {@}
    #var_capture:
        '&' @ ID
        {@}
    ;
    #ast_capture:
        '@' \s0 @ ID?
        {@}
    ;
    #fail_capture:
        '%' \s0 @ name?
        {@}
    ;
    #pattern:
        @ name | group | dyn | STRING | CGROUP | ANY | SPACE | NOSPACE
        {@}
    ;
    #one_capture:
        @ var_capture? @ ast_capture? @ fail_capture? @ pattern @ alternative* @ counter? @ shared_counter_registration?

        @{v_cap, ast_cap, fail_cap, val, alts, quantifier, registration}
    ;
    #mul_capture:
        @ '@' | '%' '=' '(' @ one_capture+ ')'

        @{type, cap}
    ;
    #STRING:
        ['"] @ (('\\' [*]) | [^'\\])* ['"]
        {@}
    ;
    #CGROUP:
        '[' @ '^'? @ ([^\\\]] | ('\\' [*]))+ ']'

        @{negative, v}
    ;
    #ANY:
        '[' '*' ']'
    ;
    #SPACE:
        '\\s'
    ;
    #NOSPACE:
        '\\s0'
    ;
    #group:
        '(' @ value+ ')'
        {@}
    ;
    #dyn:
        '$' @ dyn_expr | ID

        {@}

        #dyn_expr:
            '{' @ expr '}'
            {@}
        ;
    ;
    #alternative:
        '|' @ pattern
        {@}
    ;
    #QUANTIFIER:
       @ '?' | '+' | '*'
       {@}
    ;
    #counter:
       @ bounded | quantified
       {@}
       #quantified:
           @ QUANTIFIER @ bounded?
           @{quantifier, repetitions}
       ;
       #bounded:
             '=' @ NUMBER | ID | expr

             {@}
       ;
    ;
    #shared_counter_registration:
        '=>' @ ID
        {@}
    ;
;
nested_rule:
    '#' \s0 @ grammar
    {@}
;

// Assignment arrows belong to other ISPA constructs. In an AST field they
// almost always mean ':': replace the separator without eating its expression.
fail ast_field_separator {
    ctx.error("expected ':' after AST field name; '=' and '=>' are not AST field separators")
    if ctx.at("=") or ctx.at("=>"):
        ctx.replace()
    else:
        ctx.insert()
}