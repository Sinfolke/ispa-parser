ID:
    ([a-zA-Z_] [a-zA-Z0-9_]*)
;
NUMBER:
    [0-9]+ ('.' [0-9]+)?
;
name:
    ID ('->' ID)* template_params? params?
;
PY_RAW:
    'p{' 'py' '}'
;

expr:
    PY_RAW
;

explicit_expr:
    '(' expr ')'
;
stmt:
    PY_RAW
;
forward_declaration:
    '->' ID '->'
;
params:
    '(' param? ')'
;
template_params:
    '<' param? '>'
;
param:
    ID (',' ID)*
;