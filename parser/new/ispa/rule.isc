grammar:
    @ name @ rule | advanced_rule

    @{name, entry}

    #modifier:
        '[' @ ID ']'
        {@}
    ;
;
rule:
    ':' @ #value+ @ #ast? @ #nested_rule* ';'
    @{v, data, nested}

    #ast:
        @ #abbr | #full | #single_value
        {@}

        #full:
            '&' '{' @ #part+ '}'

            {@}

            #part:
                @ ID ':' @ expr
                @{key, e}
            ;
        ;
        #abbr:
            '@' '{' @ ID+ '}'
            {@}
        ;
        #single_value:
            '{' @ expr '}'
            {@}
        ;
    ;
    #value:
        @ #var_capture? @ #ast_capture? @ #pattern @ #alternative* @ #counter? @ #shared_counter_registration?
        @{v_cap, ast_cap, val, alts, quantifier, registration}

        #var_capture:
            '&' @ ID
            {@}
        ;
        #ast_capture:
            '@' (\s0 @ ID)?
            {@}
        ;
        #pattern:
            @ name | group | STRING | CGROUP | SPACE
            {@}
        ;
        #STRING:
            '\'' @ [^']* '\''

            {@}
        ;
        #CGROUP:
            '[' @ ([^\]] | '\\]')+ ']'

            {@}
        ;
        #SPACE:
            '\\s'
            {@}
        ;
        #group:
            '(' @ value+ ')'
            {@}
        ;
        #alternative:
            '|' @ pattern
            {@}
        ;
        #QUANTIFIER:
           @ '?' | '+' | '*'
           {@}
        ;
        #counter:
           @ QUANTIFIER @ #bounded?

           @{quantifier, repetitions}
           #bounded:
                 '=' @ NUMBER | ID | explicit_expr

                 {@}
           ;
        ;
        #shared_counter_registration:
            '=>' @ ID
            {@}
        ;
    ;
    #nested_rule:
        '#' \s0 @ grammar
        {@}
    ;
;
advanced_rule:
    '{' @ #dep_decl* @ (#match | stmt)* '}'

    @{dep, body}
    #dep_decl:
        'depends' @ forward_declaration
        {@}
    ;
    #match:
        'match' @ rule.value+ @ #unpack | ';'
        @{patterns, assign_names}

        #unpack:
            '->' @ ID+

            {@}
        ;
    ;
    #fail_call:
        'fail' @ name

        {@}
    ;
;