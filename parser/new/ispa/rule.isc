rule:
    @ ID ':' @ #value+ ';'
    @{name, v}

    #capture:
        '@' (\s0 @ ID)?
        {@}
    ;
    #value:
        @ #pattern @ #alternative* @ #QUANTIFIER?
        @{v, alts, quantifier}

        #pattern:
            @ ID | #STRING | #SPACE | group
            {@}
        ;
        #STRING:
            '\'' @ [^']* '\''

            {@}
        ;
        #SPACE:
            '\\s'
            {@}
        ;
        #group:
            '(' @ #value+ ')'
            {@}
        ;
        #alternative:
            '|' @ pattern
            {@}
        ;
        #QUANTIFIER:
           @ '?' | '+' | '*'
           {@}
        ;
    ;
;


main:
    @ rule
    {@}
;