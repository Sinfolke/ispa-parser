ID:
    @ ([a-zA-Z] [a-zA-Z0-9_]*)
    {@}
;
NUMBER:
    @ [0-9]+ ('.' @ [0-9]+)?

    @{full, floating}
;
name:
    @ ID ('->' @ ID)* @ template_params? @ params?

    @{primary, nested, temp_params, param}
;
PY_RAW:
    'p{' @ 'py' '}'
    {@}
;

expr:
    @ PY_RAW
    {@}
;

explicit_expr:
    '(' @ expr ')'
    {@}
;
stmt:
    @ PY_RAW
    {@}
;
forward_declaration:
    '->' @  ID '->'
    {@}
;
params:
    '(' @ param? ')'
    {@}
;
template_params:
    '<' @ param? '>'
    {@}
;
param:
    @ ID (',' @ ID)*
    @{first_p, following_p}
;